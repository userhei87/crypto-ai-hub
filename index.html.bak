    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- Навигация -->
    <header class="navbar">
        <div class="container">
            <a href="index.html" class="logo">Crypto<span>AI</span> Hub</a>
            <nav class="nav-links">
                <a href="#guides-section" class="nav-link">Гайды</a>
                <a href="legal/disclaimer.html" class="nav-link">Дисклеймер</a>
